// awww-daemon runs as a systemd user service (home.nix) so it auto-restarts
// if it dies - a dead daemon silently shows a black wallpaper
// Lock handling: `lock` fires on loginctl lock-session (lid-close when docked, manual bind),
// `before-sleep` locks ahead of suspend so lid-open lands on gtklock.
// pidof guard: don't stack a second gtklock when both events fire.
spawn-at-startup "swayidle" "-w" \
    "timeout" "600" "pidof gtklock || gtklock -d" \
    "timeout" "900" "niri msg action power-off-monitors" \
    "before-sleep" "pidof gtklock || gtklock -d" \
    "lock" "pidof gtklock || gtklock -d"

// General Settings
prefer-no-csd
screenshot-path "~/Pictures/Screenshots/%Y-%m-%d %H-%M-%S.png"

// Monitor Setup - External monitor on the RIGHT
output "HDMI-A-1" {
    mode "1920x1080@60.000" // change to 240 if your screen supports it, e.g. "1920x1080@240.000"
    position x=0 y=0
    scale 1
}

output "eDP-1" {
    // laptop internal panel; check `niri msg outputs` if the connector changes
    mode "2560x1600@240.000"
    position x=1920 y=0
}

input {
    keyboard {
        xkb {
            layout "pl"
            options "caps:escape"
        }
    }

    touchpad {
        tap
        natural-scroll
    }

    focus-follows-mouse
    workspace-auto-back-and-forth
}

hotkey-overlay {
    skip-at-startup
}

cursor {
    hide-when-typing
    hide-after-inactive-ms 5000
}

overview {
    backdrop-color "#1E1E2E"
    workspace-shadow {
        off
    }
}

layer-rule {
    match namespace="^awww-daemon$"
    place-within-backdrop true
}

binds {
    // ── System ───────────────────────────────────────────────────────
    MOD+S            hotkey-overlay-title="Show shortcuts"                    { show-hotkey-overlay; }
    MOD+SHIFT+E      hotkey-overlay-title="Logout"                            { quit; }
    MOD+ALT+W        hotkey-overlay-title="Restart Quickshell"                { spawn "bash" "/home/dhm/.config/quickshell/scripts/restart.sh"; }
    MOD+ALT+L        hotkey-overlay-title="Lock screen"                       { spawn "loginctl" "lock-session"; }

    // ── Launch apps ──────────────────────────────────────────────────
    MOD+RETURN       hotkey-overlay-title="Terminal (ghostty)"                { spawn-sh "ghostty"; }
    MOD+Q            hotkey-overlay-title="Browser (librewolf)"               { spawn-sh "librewolf"; }
    MOD+R            hotkey-overlay-title="App launcher"                      { spawn-sh "echo x > /run/user/1000/qs-launcher"; }
    MOD+E            hotkey-overlay-title="Files"                             { spawn-sh "echo x > /run/user/1000/qs-fm"; }

    // ── Focus ────────────────────────────────────────────────────────
    MOD+H            hotkey-overlay-title="Focus left"                        { focus-column-left; }
    MOD+L            hotkey-overlay-title="Focus right"                       { focus-column-right; }
    MOD+K            hotkey-overlay-title="Focus workspace up"                { focus-workspace-up; }
    MOD+J            hotkey-overlay-title="Focus workspace down"              { focus-workspace-down; }
    MOD+LEFT         hotkey-overlay-title="Focus left"                        { focus-column-left; }
    MOD+RIGHT        hotkey-overlay-title="Focus right"                       { focus-column-right; }
    MOD+UP           hotkey-overlay-title="Focus window up"                   { focus-window-up; }
    MOD+DOWN         hotkey-overlay-title="Focus window down"                 { focus-window-down; }
    MOD+HOME         hotkey-overlay-title="Focus first column"                { focus-column-first; }
    MOD+END          hotkey-overlay-title="Focus last column"                 { focus-column-last; }
    MOD+TAB          hotkey-overlay-title="Previous workspace"                { focus-workspace-previous; }

    // ── Move windows ─────────────────────────────────────────────────
    MOD+SHIFT+H      hotkey-overlay-title="Move column left"                  { move-column-left; }
    MOD+SHIFT+L      hotkey-overlay-title="Move column right"                 { move-column-right; }
    MOD+SHIFT+K      hotkey-overlay-title="Move to workspace up"              { move-column-to-workspace-up; }
    MOD+SHIFT+J      hotkey-overlay-title="Move to workspace down"            { move-column-to-workspace-down; }
    MOD+SHIFT+LEFT   hotkey-overlay-title="Move column left"                  { move-column-left; }
    MOD+SHIFT+RIGHT  hotkey-overlay-title="Move column right"                 { move-column-right; }
    MOD+SHIFT+UP     hotkey-overlay-title="Move window up"                    { move-window-up; }
    MOD+SHIFT+DOWN   hotkey-overlay-title="Move window down"                  { move-window-down; }
    MOD+SHIFT+HOME   hotkey-overlay-title="Move to first column"              { move-column-to-first; }
    MOD+SHIFT+END    hotkey-overlay-title="Move to last column"               { move-column-to-last; }

    // ── Monitors ─────────────────────────────────────────────────────
    MOD+CTRL+H       hotkey-overlay-title="Focus monitor left"                { focus-monitor-left; }
    MOD+CTRL+L       hotkey-overlay-title="Focus monitor right"               { focus-monitor-right; }
    MOD+CTRL+K       hotkey-overlay-title="Focus monitor up"                  { focus-monitor-up; }
    MOD+CTRL+J       hotkey-overlay-title="Focus monitor down"                { focus-monitor-down; }
    MOD+CTRL+LEFT    hotkey-overlay-title="Focus monitor left"                { focus-monitor-left; }
    MOD+CTRL+RIGHT   hotkey-overlay-title="Focus monitor right"               { focus-monitor-right; }
    MOD+CTRL+UP      hotkey-overlay-title="Focus monitor up"                  { focus-monitor-up; }
    MOD+CTRL+DOWN    hotkey-overlay-title="Focus monitor down"                { focus-monitor-down; }

    MOD+SHIFT+CTRL+H     hotkey-overlay-title="Move to monitor left"          { move-column-to-monitor-left; }
    MOD+SHIFT+CTRL+L     hotkey-overlay-title="Move to monitor right"         { move-column-to-monitor-right; }
    MOD+SHIFT+CTRL+K     hotkey-overlay-title="Move to monitor up"            { move-column-to-monitor-up; }
    MOD+SHIFT+CTRL+J     hotkey-overlay-title="Move to monitor down"          { move-column-to-monitor-down; }
    MOD+SHIFT+CTRL+LEFT  hotkey-overlay-title="Move to monitor left"          { move-column-to-monitor-left; }
    MOD+SHIFT+CTRL+RIGHT hotkey-overlay-title="Move to monitor right"         { move-column-to-monitor-right; }
    MOD+SHIFT+CTRL+UP    hotkey-overlay-title="Move to monitor up"            { move-column-to-monitor-up; }
    MOD+SHIFT+CTRL+DOWN  hotkey-overlay-title="Move to monitor down"          { move-column-to-monitor-down; }

    // ── Workspaces ───────────────────────────────────────────────────
    MOD+ESCAPE       hotkey-overlay-title="Overview"          repeat=false    { toggle-overview; }
    MOD+1            hotkey-overlay-title=null                                   { focus-workspace 1; }
    MOD+2            hotkey-overlay-title=null                                   { focus-workspace 2; }
    MOD+3            hotkey-overlay-title=null                                   { focus-workspace 3; }
    MOD+4            hotkey-overlay-title=null                                   { focus-workspace 4; }
    MOD+5            hotkey-overlay-title=null                                   { focus-workspace 5; }
    MOD+6            hotkey-overlay-title=null                                   { focus-workspace 6; }
    MOD+7            hotkey-overlay-title=null                                   { focus-workspace 7; }
    MOD+8            hotkey-overlay-title=null                                   { focus-workspace 8; }
    MOD+9            hotkey-overlay-title=null                                   { focus-workspace 9; }
    MOD+SHIFT+1      hotkey-overlay-title=null                           { move-column-to-workspace 1; }
    MOD+SHIFT+2      hotkey-overlay-title=null                           { move-column-to-workspace 2; }
    MOD+SHIFT+3      hotkey-overlay-title=null                           { move-column-to-workspace 3; }
    MOD+SHIFT+4      hotkey-overlay-title=null                           { move-column-to-workspace 4; }
    MOD+SHIFT+5      hotkey-overlay-title=null                           { move-column-to-workspace 5; }
    MOD+SHIFT+6      hotkey-overlay-title=null                           { move-column-to-workspace 6; }
    MOD+SHIFT+7      hotkey-overlay-title=null                           { move-column-to-workspace 7; }
    MOD+SHIFT+8      hotkey-overlay-title=null                           { move-column-to-workspace 8; }
    MOD+SHIFT+9      hotkey-overlay-title=null                           { move-column-to-workspace 9; }

    MOD+WHEELSCROLLDOWN              cooldown-ms=100 { focus-workspace-down; }
    MOD+WHEELSCROLLUP                cooldown-ms=100 { focus-workspace-up; }
    MOD+SHIFT+WHEELSCROLLDOWN        cooldown-ms=100 { move-column-to-workspace-down; }
    MOD+SHIFT+WHEELSCROLLUP          cooldown-ms=100 { move-column-to-workspace-up; }
    MOD+WHEELSCROLLRIGHT                             { focus-column-right; }
    MOD+WHEELSCROLLLEFT                              { focus-column-left; }
    MOD+CTRL+WHEELSCROLLRIGHT                        { move-column-right; }
    MOD+CTRL+WHEELSCROLLLEFT                         { move-column-left; }

    // ── Window management ────────────────────────────────────────────
    MOD+SHIFT+C      hotkey-overlay-title="Close window"                      { close-window; }
    MOD+T            hotkey-overlay-title="Toggle floating"                   { toggle-window-floating; }
    MOD+F            hotkey-overlay-title="Fullscreen"                        { fullscreen-window; }
    MOD+M            hotkey-overlay-title="Maximize column"                   { maximize-column; }
    MOD+C            hotkey-overlay-title="Center column"                     { center-column; }
    MOD+CTRL+C       hotkey-overlay-title="Center all visible columns"        { center-visible-columns; }

    // ── Resize ───────────────────────────────────────────────────────
    MOD+BRACKETLEFT        hotkey-overlay-title="Shrink column width"         { set-column-width "-10%"; }
    MOD+BRACKETRIGHT       hotkey-overlay-title="Grow column width"           { set-column-width "+10%"; }
    MOD+SHIFT+BRACKETLEFT  hotkey-overlay-title="Shrink window height"        { set-window-height "-10%"; }
    MOD+SHIFT+BRACKETRIGHT hotkey-overlay-title="Grow window height"          { set-window-height "+10%"; }
    MOD+CTRL+WHEELSCROLLDOWN                                                  { set-window-height "-5%"; }
    MOD+CTRL+WHEELSCROLLUP                                                    { set-window-height "+5%"; }

    // ── Screenshot & tools ───────────────────────────────────────────
    MOD+SHIFT+S      hotkey-overlay-title="Screenshot region"                 { screenshot; }
    MOD+CTRL+S       hotkey-overlay-title="Screenshot window"                 { screenshot-window write-to-disk=true; }
    MOD+P            hotkey-overlay-title="Color picker"                      { spawn-sh "pgrep -x hyprpicker >/dev/null || hyprpicker -a"; }
    MOD+Period       hotkey-overlay-title="Emoji picker"                      { spawn-sh "bemoji -n"; }
    MOD+SHIFT+T      hotkey-overlay-title="OCR region to clipboard"           { spawn-sh "ocr-clip"; }
    MOD+SHIFT+A      hotkey-overlay-title="Toggle mic self-monitor"          { spawn-sh "pkill -f 'pw-loopback.*easyeffects_source' || pw-loopback --capture-props=target.object=easyeffects_source --playback-props=target.object=alsa_output.pci-0000_06_00.6.analog-stereo"; }
}


// Layout Settings
layout {
    gaps 0
    center-focused-column "on-overflow"
    background-color "transparent"

    preset-column-widths {
        proportion 0.33333
        proportion 0.5
        proportion 0.66667
    }

    focus-ring {
        width 0
        active-color "#2E3440"
    }

    insert-hint {
        off
        color "#2E3440"
    }

    struts {}
}

// Animation Settings
animations {
    workspace-switch {
        spring damping-ratio=1.0 stiffness=1000 epsilon=0.0001
    }
    window-open {
        duration-ms 200
        curve "ease-out-quad"
    }
    window-close {
        duration-ms 200
        curve "ease-out-cubic"
    }
    horizontal-view-movement {
        spring damping-ratio=1.0 stiffness=900 epsilon=0.0001
    }
    window-movement {
        spring damping-ratio=1.0 stiffness=800 epsilon=0.0001
    }
    window-resize {
        spring damping-ratio=1.0 stiffness=1000 epsilon=0.0001
    }
    config-notification-open-close {
        spring damping-ratio=0.6 stiffness=1200 epsilon=0.001
    }
    screenshot-ui-open {
        duration-ms 300
        curve "ease-out-quad"
    }
    overview-open-close {
        spring damping-ratio=1.0 stiffness=900 epsilon=0.0001
    }
}

window-rule {
    // desktop Bitwarden app + librewolf extension popup (title arrives after
    // open, but app-id "librewolf" + the Extension title is enough to float it)
    match app-id=r#"(?i)bitwarden"#
    match app-id=r#"librewolf"# title=r#"(?i)bitwarden"#
    match app-id=r#"librewolf"# title=r#"Extension:"#
    // niri open-floating only fires at map time; the librewolf extension popup
    // maps with an empty title so it can't be auto-floated. The size clamp still
    // applies dynamically → press MOD+T to float it (centered at 420x640).
    open-floating true
    min-width 420
    max-width 420
    min-height 640
    max-height 640
}

window-rule {
    match app-id=r#"librewolf"#
    match app-id=r#"vesktop"#
    match app-id=r#"obsidian$"#
    exclude title=r#"Bitwarden"#
    exclude title=r#"Extension:"#
    open-maximized true
}

window-rule {
    match title=r#".*(Open|Save|Select).*"#
    exclude app-id=r#"librewolf"#
    exclude app-id=r#"vesktop"#
    open-floating true
    default-column-width { proportion 0.0; }
    max-width 800
    max-height 1000
}

window-rule {
    match title=r#".*File.*"#
    exclude app-id=r#"librewolf"#
    exclude app-id=r#"vesktop"#
    open-floating true
    default-column-width { proportion 0.0; }
    max-width 800
    max-height 1000
}

window-rule {
    match app-id=r#"org\.gtk\.FileChooserDialog"#
    open-floating true
    default-column-width { proportion 0.0; }
    max-width 800
    max-height 1000
}

window-rule {
    match title=r#".*Sign in - Google Accounts - Mozilla Firefox"#
    open-floating true
}

window-rule {
    match title=r#".*(Dialog|Properties|Preferences|Settings|Rename).*"#
    exclude app-id=r#"librewolf"#
    exclude app-id=r#"vesktop"#
    open-floating true
}

window-rule {
    match app-id=r#"zenity"#
    open-floating true
}

window-rule {
    match app-id=r#"org\.kde\.polkit-kde-authentication-agent-1"#
    open-floating true
}

window-rule {
    match title=r#".*Authentication.*"#
    open-floating true
}

window-rule {
    match app-id=r#"org\.keepassxc\.KeePassXC"# title=r#".*Auto-Type.*"#
    open-floating true
}

window-rule {
    match app-id=r#"Bitwarden"# title=r#".*unlock.*"#
    open-floating true
}

window-rule {
    match app-id=r#"nm-connection-editor"#
    open-floating true
}

window-rule {
    match app-id=r#"blueman-manager"#
    open-floating true
}

window-rule {
    match app-id=r#"pavucontrol"#
    open-floating true
}


window-rule {
    geometry-corner-radius 0
    clip-to-geometry true
}

window-rule {
    match is-active=false
    opacity 0.9
}

// Environment Variables
environment {

    ELECTRON_OZONE_PLATFORM_HINT "auto"
    XDG_SESSION_TYPE "wayland"
    XDG_CURRENT_DESKTOP "niri"
    QT_QPA_PLATFORM "wayland"
    QT_QPA_PLATFORMTHEME "gtk3"
    QT_QPA_PLATFORMTHEME_QT6 "gtk3"
    QT_WAYLAND_DISABLE_WINDOWDECORATION "1"
    QT_AUTO_SCREEN_SCALE_FACTOR "1"
    GDK_BACKEND "wayland,x11"
    MOZ_ENABLE_WAYLAND "1"
    MOZ_DBUS_REMOTE "1"
    _JAVA_AWT_WM_NONREPARENTING "1"
    SDL_VIDEODRIVER "wayland"
    CLUTTER_BACKEND "wayland"
    VDPAU_DRIVER "va_gl"
    LIBVA_DRIVER_NAME "iHD"
}
