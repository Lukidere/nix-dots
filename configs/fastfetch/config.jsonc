{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": { "type": "small", "padding": { "top": 1, "right": 3 } },
  "display": { "separator": "  " },
  "modules": [
    "break",
    { "type": "title", "keyWidth": 10 },
    "break",
    { "type": "os",         "key": "  ", "keyColor": "blue" },
    { "type": "kernel",     "key": "  ", "keyColor": "blue" },
    { "type": "packages",   "key": "  ", "keyColor": "cyan" },
    { "type": "shell",      "key": "  ", "keyColor": "cyan" },
    { "type": "wm",         "key": "  ", "keyColor": "magenta" },
    { "type": "terminal",   "key": "  ", "keyColor": "magenta" },
    "break",
    { "type": "cpu",        "key": "  ", "keyColor": "green" },
    { "type": "gpu",        "key": "  ", "keyColor": "green" },
    { "type": "memory",     "key": "  ", "keyColor": "yellow" },
    { "type": "disk",       "key": "  ", "keyColor": "yellow" },
    { "type": "uptime",     "key": "  ", "keyColor": "red" },
    "break",
    { "type": "colors", "paddingLeft": 2, "symbol": "circle" }
  ]
}
